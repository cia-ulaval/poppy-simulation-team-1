# Environnements virtuels et caches : jamais dans le contexte de build.
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]

# Git et outillage
.git/
.gitignore
.idea/
.vscode/
.claude/

# Sorties d'exécution : elles n'ont rien à faire dans une image.
logs/
runs/
figs/
scenes/
*.mp4

# Modèles entraînés (~28 Mo). Ils sont montés en volume quand on en a besoin,
# pas copiés dans l'image : sinon chaque reconstruction les recopie.
models/

# Captures de profondeur (~59 Mo). Non couvertes jusqu'ici, elles partaient
# donc dans les images train et bridge, qui ne les utilisent pas.
scripts/vision/

# Documentation : utile aux humains, inutile au conteneur.
docs/
