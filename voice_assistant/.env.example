# Copier ce fichier en voice_assistant/.env (sans « .example »), puis coller la clé.
# Le .env est ignoré par git : il ne doit jamais être commité, ni partagé en public.
OPENAI_API_KEY=sk-colle-ta-cle-ici

# Micro et haut-parleur : laisser commenté pour prendre ceux par défaut du système
# (votre ordinateur). Numéro ou morceau du nom, voir `python -m sounddevice`.
# Sur le robot : POPPY_MICRO=1 et POPPY_HAUT_PARLEUR=2.
# POPPY_MICRO=1
# POPPY_HAUT_PARLEUR=2
