    <mesh name="chest_v"             file="chest_visual.STL" />
    <mesh name="neck_v"              file="neck_visual.STL" />
    <mesh name="head_v"              file="head_visual.STL" />
    <mesh name="l_shoulder_v"        file="l_shoulder_visual.STL" />
    <mesh name="l_shoulder_motor_v"  file="l_shoulder_motor_visual.STL" />
    <mesh name="l_upper_arm_v"       file="l_upper_arm_visual.STL" />
    <mesh name="l_forearm_v"         file="l_forearm_visual.STL" />
