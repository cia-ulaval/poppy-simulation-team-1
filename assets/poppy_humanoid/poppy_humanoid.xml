<?xml version="1.0" encoding="utf-8"?>
<!--
  MuJoCo MJCF model for the Poppy Humanoid robot.
  Converted from the official URDF:
  https://github.com/poppy-project/poppy-humanoid/tree/master/hardware/URDF
  25 revolute joints, 22 links, ~3.5 kg, ~83 cm tall.
-->
<mujoco model="poppy_humanoid">

  <compiler meshdir="meshes" angle="radian" />

  <option integrator="RK4" timestep="0.002" />

  <default>
    <joint damping="0.3" armature="0.01" limited="true" />
    <!-- contype=2, conaffinity=1: body geoms collide with floor (contype=1)
         but NOT with each other (2 & 1 = 0). -->
    <geom contype="2" conaffinity="1" condim="3" />
    <motor ctrllimited="true" />
  </default>

  <asset>
    <!-- Visual meshes (no collision) -->
    <mesh name="pelvis_v"            file="pelvis_visual.STL" />
    <mesh name="r_hip_v"             file="r_hip_visual.STL" />
    <mesh name="r_hip_motor_v"       file="r_hip_motor_visual.STL" />
    <mesh name="r_thigh_v"           file="r_thigh_visual.STL" />
