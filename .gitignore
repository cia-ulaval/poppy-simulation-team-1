# Environnements virtuels
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# IDE
.idea/
.vscode/

# Sorties d'exécution (jamais versionnées)
scenes/
logs/
runs/
*.mp4

# Captures de profondeur pour src/sensors/ : 59 Mo de .npy, et leur copie
# zippée juste à côté. Ce sont des données de test, pas du code. La vision
# est en pause ; quand elle reprendra, ces fichiers seront à regénérer ou à
# héberger hors du dépôt. Voir src/sensors/README.md.
scripts/vision/

# figs/ est créé par les conteneurs. On garde le dossier versionné (sinon
# Docker le crée en root sur un hôte Linux et l'utilisateur du conteneur ne
# peut pas y écrire), mais pas son contenu.
figs/*
!figs/.gitkeep

# OS
.DS_Store
Thumbs.db
